# ---- Settings page ----
msgid "Campus Network Authentication"
msgstr "校园网认证"

msgid "Manage Shanghai University Ruijie SAM+ portal login and keepalive. The daemon automatically authenticates and maintains the campus network session."
msgstr "管理上海大学锐捷 SAM+ Portal 认证与保活。守护进程自动完成认证并维持校园网会话。"

msgid "Account Settings"
msgstr "账号设置"

msgid "Enable"
msgstr "启用"

msgid "Enable campus network auto-authentication at boot"
msgstr "开机自动认证校园网"

msgid "Username"
msgstr "用户名"

msgid "Campus network portal login username"
msgstr "校园网 Portal 登录用户名"

msgid "Password"
msgstr "密码"

msgid "Campus network portal login password"
msgstr "校园网 Portal 登录密码"

msgid "ISP"
msgstr "运营商"

msgid "Select the ISP/operator for this connection"
msgstr "选择此连接使用的运营商"

msgid "China Telecom"
msgstr "中国电信"

msgid "China Unicom"
msgstr "中国联通"

msgid "China Mobile"
msgstr "中国移动"

msgid "Network Settings"
msgstr "网络设置"

msgid "Portal URL"
msgstr "Portal 地址"

msgid "Base URL of the Ruijie portal server"
msgstr "锐捷 Portal 服务器的基础 URL"

msgid "Campus Gateway"
msgstr "校园网网关"

msgid "IP of the campus network gateway for routing"
msgstr "校园网网关 IP（用于路由）"

msgid "Interface Name"
msgstr "接口名称"

msgid "Network interface name created in /etc/config/network"
msgstr "在 /etc/config/network 中创建的网络接口名"

msgid "Campus CIDR"
msgstr "校园网网段"

msgid "Campus network route prefix (e.g. 10.0.0.0/8)"
msgstr "校园网路由前缀（如 10.0.0.0/8）"

msgid "Keepalive Interval"
msgstr "保活间隔"

msgid "Seconds between keepalive requests (60-600). Setting it too low may trigger server-side rate limiting."
msgstr "两次保活请求之间的间隔秒数（60-600）。设置过小可能触发服务器限流。"

msgid "Log File"
msgstr "日志文件"

msgid "Path of the daemon log file. A path under /etc/ persists across reboots; /var/log/ is lost on reboot."
msgstr "守护进程日志文件路径。/etc/ 下的路径重启后保留；/var/log/ 重启后丢失。"

