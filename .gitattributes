# Shell scripts and router-side files MUST stay LF (ash breaks on CRLF)
*.sh            text eol=lf
Makefile        text eol=lf
root/**         text eol=lf
luasrc/**       text eol=lf
po/**           text eol=lf

# PowerShell scripts (deploy/build, not on router)
*.ps1           text eol=crlf

# Binary artifacts
*.ipk           binary
