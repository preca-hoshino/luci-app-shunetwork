#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

NAME=shunetwork
CORE=/usr/bin/shunetwork_core.sh

_start_service() {
    local enabled
    config_load shunetwork
    config_get enabled settings enabled
    [ "${enabled:-0}" = "1" ] || return 1

    procd_open_instance
    procd_set_param command /bin/sh "$CORE" daemon
    procd_set_param respawn 60 5 0
    procd_set_param pidfile /var/run/shunetwork.pid
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

start_service() {
    # Explicit service start/restart = admin intent: clear any manual
    # disconnect suppression (procd respawn does not pass through here).
    rm -f /var/run/shunetwork_suppress
    _setup_interface
    _start_service
}

stop_service() {
    # Only stop the daemon. The portal session is left intact: the PIDFILE
    # survives so the next start can resume/adopt it without a fresh login.
    # Logging out here would turn every procd reload into a re-login storm.
    :
}

service_triggers() {
    procd_add_reload_trigger "shunetwork"
}

reload_service() {
    # rc.common stop/start: procd kills the tracked process on stop.
    # (stop_service above is only a hook - calling it directly would NOT
    # terminate the daemon, leaving the old process running old config.)
    stop
    start
}

login() {
    _setup_interface
    $CORE login
}

logout() {
    $CORE logout
}

status() {
    local enabled campus_ip daemon_running pid dev
    config_load shunetwork
    config_get enabled settings enabled
    config_get dev settings device
    [ -z "$dev" ] && dev=wan
    campus_ip=$(ip -4 addr show dev "$dev" 2>/dev/null | awk '/inet 10\./{print $2}' | cut -d/ -f1)
    [ -s /var/run/shunetwork.pid ] && pid=$(cat /var/run/shunetwork.pid 2>/dev/null)
    [ -n "$pid" ] && [ -d "/proc/$pid" ] && daemon_running="true" || daemon_running="false"

    printf '{"enabled":"%s","campus_ip":"%s","daemon_running":%s' \
        "${enabled:-0}" "${campus_ip:-}" "$daemon_running"
    [ -n "$pid" ] && printf ',"pid":"%s"' "$pid"
    printf ',"uptime":"%s"' "$(cat /var/run/shunetwork_uptime 2>/dev/null)"
    printf '}\n'
}

_setup_interface() {
    local iface gw cidr target mask_hex dev
    config_load shunetwork
    config_get iface settings interface
    config_get gw settings gateway
    config_get cidr settings cidr
    config_get dev settings device
    [ -z "$iface" ] && iface=campus
    [ -z "$dev" ] && dev=wan
    [ -z "$gw" ] && return 1
    [ -z "$cidr" ] && return 1

    target="${cidr%/*}"
    mask="${cidr#*/}"

    # Create the interface when missing, and always enforce the critical
    # fields: a stale hand-made config (e.g. device=campus -> NO_DEVICE)
    # silently breaks DHCP and the whole auth chain.
    if ! uci -q get network."$iface" >/dev/null 2>&1; then
        uci set network."$iface"=interface
    fi
    uci -q batch <<-EOF
		set network.$iface.device=$dev
		set network.$iface.proto=dhcp
		set network.$iface.gateway=0.0.0.0
	EOF
    uci commit network

    # Prune ALL stale routes for this target (wrong gateway or duplicate)
    # and install a single correct one. We iterate with raw uci instead of
    # config_foreach to avoid stale-cache issues after uci delete.
    local idx=0 count=0
    while uci -q get network.@route[$idx] >/dev/null 2>&1; do
        count=$((idx + 1))
        idx=$((idx + 1))
    done
    # Delete in reverse order so indices stay valid
    idx=$count
    while [ $idx -gt 0 ]; do
        idx=$((idx - 1))
        local t
        t=$(uci -q get network.@route[$idx].target 2>/dev/null)
        [ "$t" = "$target" ] && uci delete network.@route[$idx]
    done
    uci -q batch <<-EOF
		add network route
		set network.@route[-1].interface=$iface
		set network.@route[-1].target=$target
		set network.@route[-1].netmask=$(_cidr_to_netmask "$mask")
		set network.@route[-1].gateway=$gw
	EOF
    uci commit network

    # Ensure the underlying device exists before ifup (e.g. macvlan)
    _ensure_device "$dev"

    ifup "$iface" 2>/dev/null || true
}

# Create the underlying device when it does not exist yet (macvlan, veth,
# etc.).  The device section is defined in /etc/config/network; we only
# materialise it here because netifd does not auto-create certain types
# until the first interface claiming them goes through a full reload.
_ensure_device() {
    local dev=$1
    # Physical and kernel-managed interfaces need no action.
    ip link show dev "$dev" >/dev/null 2>&1 && return 0

    local idx=0 name type parent mode
    while uci -q get network.@device[$idx] >/dev/null 2>&1; do
        name=$(uci -q get network.@device[$idx].name)
        if [ "$name" = "$dev" ]; then
            type=$(uci -q get network.@device[$idx].type)
            parent=$(uci -q get network.@device[$idx].parent)
            mode=$(uci -q get network.@device[$idx].mode)
            case "$type" in
                macvlan)
                    [ -n "$parent" ] && ip link add link "$parent" name "$dev" type macvlan ${mode:+mode $mode}
                    ip link set "$dev" up
                    ;;
                *)
                    return 1
                    ;;
            esac
            return 0
        fi
        idx=$((idx + 1))
    done
    return 1
}

_cidr_to_netmask() {
    local mask=$1 i
    local result=""
    for i in 0 1 2 3; do
        [ $i -gt 0 ] && result="${result}."
        if [ "$mask" -ge 8 ]; then
            result="${result}255"
            mask=$((mask - 8))
        elif [ "$mask" -gt 0 ]; then
            result="${result}$((256 - 2^(8-mask)))"
            mask=0
        else
            result="${result}0"
        fi
    done
    echo "$result"
}
